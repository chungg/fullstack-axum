{
    "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
    "assist": {
        "enabled": true,
        "actions": { "source": { "organizeImports": "on" } }
    },
    "linter": {
        "enabled": true,
        "rules": { "preset": "recommended" }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 100
    },
    "javascript": { "formatter": { "quoteStyle": "double" } }
}
